PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/findit
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
# Public base URL of this server (used to build links to locally stored images)
SERVER_PUBLIC_URL=http://localhost:5000

# Optional: if any of the three is empty, images are saved to server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional email (reserved; the app works without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Set to true to boot the API without downloading models (UI testing only)
SKIP_MODELS=false
